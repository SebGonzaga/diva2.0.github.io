{
  "functions": {
    "api/chat.js": {
      "maxDuration": 30,
      "includeFiles": "assets/js/demo-data.js"
    },
    "api/daily-digest.js": {
      "maxDuration": 60
    },
    "api/incident-update.js": {
      "maxDuration": 30,
      "includeFiles": "assets/js/demo-data.js"
    },
    "api/broadcast.js": {
      "maxDuration": 60,
      "includeFiles": "assets/js/{demo-data,taal-places}.js"
    },
    "api/notifications.js": {
      "maxDuration": 30,
      "includeFiles": "assets/js/{demo-data,taal-places}.js"
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/daily-digest",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/daily-digest?pass=2",
      "schedule": "0 5 * * *"
    }
  ]
}